  .home .field-row { display: grid; gap: 20px; }
  .home .form__actions { display: flex; flex-wrap: wrap; gap: 12px; }
  .home .btn { min-height: 52px; padding: 12px 24px; border-radius: 4px; font-weight: 700; cursor: pointer; border: 2px solid var(--bleu-travail); transition: background-color 0.2s, color 0.2s; }
  .home .btn--ink { background: var(--bleu-travail); color: #fff; }
  .home .btn--ink:hover { background: var(--eau-froide); border-color: var(--eau-froide); }
  .home .btn--line { background: transparent; color: var(--bleu-travail); }
  .home .btn--line:hover { background: var(--bleu-travail); color: #fff; }
  @media (min-width: 640px) { .home .field-row { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 1000px) { .home .devis__grid { grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); gap: 72px; } }

  /* Arrivée : le robinet */
  .home .page > .final { padding-bottom: clamp(72px, 10vw, 128px); }
  .home .final .sec-head { padding-top: 184px; margin-bottom: 32px; }
  .home .final .branch { top: 34px; font-size: 1rem; width: calc(var(--gut) - var(--pipe-x) - var(--pipe-w)); border-radius: 0; }
  .home .final h2 { max-width: 14ch; font-size: clamp(2.25rem, 6.4vw, 4.75rem); }
  .home .tap { position: absolute; top: 0; left: -2px; width: 120px; height: 150px; overflow: visible; }
  .home .tap__body { fill: var(--email); stroke: var(--bleu-travail); stroke-width: 2.5; stroke-linejoin: round; stroke-linecap: round; }
  .home .tap__drop { fill: var(--eau-froide); opacity: 0; transform-box: fill-box; transform-origin: 50% 0; }
  .home .final.is-flowing .tap__drop { animation: goutte 2.4s cubic-bezier(0.5, 0, 0.9, 0.4) infinite; }
  @keyframes goutte {
    0% { opacity: 0; transform: scale(0.2); }
    35% { opacity: 1; transform: scale(1); }
    60% { opacity: 1; transform: translateY(0) scale(1); }
    100% { opacity: 0; transform: translateY(30px) scale(0.9); }
  }

  /* Pied de page */
  .home .foot { background: var(--email); border-top: 2px solid var(--bleu-travail); padding: 48px var(--edge) 32px var(--gut); }
  .home .foot__grid { max-width: calc(1320px - var(--gut) - var(--edge)); display: grid; gap: 28px; }
  .home .foot__name { font-family: var(--display); font-stretch: 75%; font-weight: 800; font-size: 1.5rem; line-height: 1.1; }
  .home .foot__h { font-weight: 700; margin-bottom: 4px; }
  .home .foot p { color: var(--ardoise); }
  .home .foot p.foot__name, .home .foot p.foot__h { color: var(--bleu-travail); }
  .home .foot a { color: var(--bleu-travail); display: inline-block; padding: 6px 0; }
  .home .foot__legal { margin-top: 40px; display: flex; flex-wrap: wrap; gap: 8px 24px; align-items: baseline; font-size: 0.9375rem; }
  @media (min-width: 720px) { .home .foot__grid { grid-template-columns: 1.4fr 1fr 1fr; gap: 48px; } }
  @media (min-width: 1320px) { .home .foot { padding-left: calc((100vw - 1320px) / 2 + var(--gut)); } }

  /* Barre d'appel mobile */
  .home .callbar {
    position: fixed; z-index: 50; left: 0; right: 0; bottom: 0;
    display: flex; gap: 8px; padding: 10px 12px calc(10px + env(safe-area-inset-bottom));
    background: var(--email); border-top: 2px solid var(--bleu-travail);
    transform: translateY(110%); transition: transform 0.45s var(--ease);
  }
  .home .callbar[hidden] { display: none; }
  .home .callbar.is-on { transform: none; }
  .home .callbar a { min-height: 52px; display: inline-flex; align-items: center; justify-content: center; gap: 10px; border-radius: 4px; font-weight: 700; text-decoration: none; }
  .home .callbar__call { flex: 1; background: var(--eau-chaude); color: #fff; font-variant-numeric: tabular-nums; }
  .home .callbar__devis { padding: 0 18px; border: 2px solid var(--bleu-travail); }
  @media (min-width: 720px) { .home .callbar { display: none; } }

  @media (prefers-reduced-motion: reduce) {
    .home .branch i, .home .callbar, .home .call, .home .faq summary .ico { transition: none; }
    .home .final.is-flowing .tap__drop { animation: none; opacity: 1; }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('.home');
  if (root) {
    root.classList.add('js');
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

    /* Le tuyau se remplit au défilement */
    const page = root.querySelector<HTMLElement>('.page')!;
    const water = root.querySelector<HTMLElement>('.pipe__water')!;
    const branches = [...root.querySelectorAll<HTMLElement>('.branch')];
    const final = root.querySelector<HTMLElement>('.final')!;
    const pipe = root.querySelector<HTMLElement>('.pipe')!;
    const tapBranch = root.querySelector<HTMLElement>('.branch--tap')!;
    let queued = false;

    const fill = () => {
      queued = false;
      const rect = page.getBoundingClientRect();
      // Le tuyau s'arrête au robinet ; le niveau rattrape le bas de l'écran en fin de page
      const end = tapBranch.getBoundingClientRect().bottom - rect.top;
      pipe.style.height = `${end}px`;
      const max = document.documentElement.scrollHeight - innerHeight;
      const progress = max > 0 ? Math.min(1, scrollY / max) : 1;
      const level = reduced ? end : Math.max(0, Math.min(end, innerHeight * (0.62 + 0.38 * progress ** 3) - rect.top));
      water.style.setProperty('--level', String(level / end));
      for (const b of branches) {
        const y = b.getBoundingClientRect().top - rect.top;
        const wet = level >= y - 1;
        b.classList.toggle('is-wet', wet);
        if (b.classList.contains('branch--tap')) final.classList.toggle('is-flowing', wet);
      }
    };
    const onScroll = () => { if (!queued) { queued = true; requestAnimationFrame(fill); } };
    addEventListener('scroll', onScroll, { passive: true });
    addEventListener('resize', onScroll);
    fill();

    /* Premiers gestes : onglets */
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('.triage [role="tab"]')];
    const select = (tab: HTMLButtonElement, focus = false) => {
      for (const t of tabs) {
        const on = t === tab;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
        const panel = document.getElementById(t.getAttribute('aria-controls')!);
        if (panel) panel.hidden = !on;
      }
      if (focus) tab.focus();
    };
    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => select(tab));
      tab.addEventListener('keydown', (e) => {
        const step = { ArrowRight: 1, ArrowDown: 1, ArrowLeft: -1, ArrowUp: -1 }[e.key];
        if (step) { e.preventDefault(); select(tabs[(i + step + tabs.length) % tabs.length], true); }
        if (e.key === 'Home') { e.preventDefault(); select(tabs[0], true); }
        if (e.key === 'End') { e.preventDefault(); select(tabs[tabs.length - 1], true); }
      });
    });

    /* Recherche de commune */
    const input = root.querySelector<HTMLInputElement>('#recherche-commune')!;
    const results = root.querySelector<HTMLUListElement>('.search__results')!;
    const status = root.querySelector<HTMLElement>('#recherche-etat')!;
    const idle = status.textContent!;
    const norm = (s: string) => s.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/[-']/g, ' ').trim();
    let index: [string, string, string, string][] | null = null;
    let loading: Promise<void> | null = null;

    const load = () => loading ??= fetch('/communes-index.json')
      .then((r) => { if (!r.ok) throw new Error(String(r.status)); return r.json(); })
      .then((rows: [string, string, string][]) => { index = rows.map((r) => [...r, norm(r[0])]); })
      .catch(() => { loading = null; throw new Error('index'); });

    const search = async () => {
      const q = norm(input.value);
      if (q.length < 2) { results.hidden = true; results.replaceChildren(); status.textContent = idle; return; }
      try { await load(); } catch {
        status.textContent = 'La recherche est indisponible pour le moment. Appelez-nous, nous vous dirons tout de suite si nous venons chez vous.';
        return;
      }
      if (q !== norm(input.value)) return;
      const digits = /^\d+$/.test(q);
      const found = index!
        .filter((r) => (digits ? r[2].split(' ').some((cp) => cp.startsWith(q)) : r[3].includes(q)))
        .sort((a, b) => Number(b[3].startsWith(q)) - Number(a[3].startsWith(q)) || a[0].localeCompare(b[0], 'fr'))
        .slice(0, 6);
      results.replaceChildren(...found.map(([name, slug, cps]) => {
        const li = document.createElement('li');
        const a = document.createElement('a');
        a.href = `/communes/${slug}`;
        a.textContent = name;
        const cp = document.createElement('span');
        cp.textContent = cps.split(' ')[0];
        a.append(cp);
        li.append(a);
        return li;
      }));
      results.hidden = found.length === 0;
      status.textContent = found.length
        ? `Oui, nous intervenons ici. Choisissez votre commune.`
        : `Aucune commune trouvée pour « ${input.value.trim()} ». Vérifiez l'orthographe ou appelez-nous.`;
    };
    input.addEventListener('focus', () => { load().catch(() => {}); }, { once: true });
    input.addEventListener('input', search);

    /* Devis : le message part par SMS ou par e-mail */
    const form = root.querySelector<HTMLFormElement>('.form')!;
    const besoin = form.querySelector<HTMLTextAreaElement>('#f-besoin')!;
    const besoinErr = form.querySelector<HTMLElement>('#f-besoin-err')!;
    besoin.addEventListener('input', () => {
      if (besoin.value.trim()) { besoin.removeAttribute('aria-invalid'); besoin.removeAttribute('aria-describedby'); besoinErr.hidden = true; }
    });
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      if (!besoin.value.trim()) {
        besoin.setAttribute('aria-invalid', 'true');
        besoin.setAttribute('aria-describedby', 'f-besoin-err');
        besoinErr.hidden = false;
        besoin.focus();
        return;
      }
      const data = new FormData(form);
      const lines = [
        'Demande de devis',
        `Besoin : ${String(data.get('besoin')).trim()}`,
        data.get('commune') ? `Commune : ${data.get('commune')}` : '',
        data.get('nom') ? `Nom : ${data.get('nom')}` : ''
      ].filter(Boolean).join('\n');
      const via = (e.submitter as HTMLButtonElement | null)?.value;
      location.href = via === 'mail'
        ? `mailto:${root.dataset.email}?subject=${encodeURIComponent('Demande de devis')}&body=${encodeURIComponent(lines)}`
        : `sms:${root.dataset.phone}?&body=${encodeURIComponent(lines)}`;
    });

    /* Barre d'appel mobile : visible dès que le bouton principal sort de l'écran */
    const bar = root.querySelector<HTMLElement>('.callbar')!;
    const mainCall = root.querySelector<HTMLElement>('[data-main-call]')!;
    bar.hidden = false;
    new IntersectionObserver(([entry]) => bar.classList.toggle('is-on', !entry.isIntersecting)).observe(mainCall);
  }
</script>
