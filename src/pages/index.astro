---
import '@fontsource-variable/bricolage-grotesque/standard.css';
import '@fontsource-variable/schibsted-grotesk/index.css';
import BaseLayout from '../layouts/BaseLayout.astro';
import communesData from '../data/communes.json';
import servicesData from '../data/services.json';
import faqData from '../data/faq.json';
import { getContactByDepartement, getAllDepartements } from '../utils/departement-contact';

const contact = getContactByDepartement('75');
const phoneIntl = `+33${contact.phone.replace(/^0/, '')}`;
const phoneSpaced = contact.phoneDisplay.replace(/\./g, ' ');

const communes = communesData.communes as any[];
const total = communes.length;
const totalDisplay = total.toLocaleString('fr-FR').replace(/ /g, ' ');

const title = 'Plombier Île-de-France, dépannage 24h/24 | Eric Plomberie';
const description = `Plombier en Île-de-France, chez vous en 30 minutes. Fuite d'eau, débouchage, chauffe-eau, chaudière : dépannage jour et nuit dans ${total} communes. Devis gratuit.`;

const featuredCommunes = communes
  .filter((c) => c.population > 50000)
  .sort((a, b) => b.population - a.population)
  .slice(0, 20);

const departements = getAllDepartements().map((d: any) => ({
  code: d.code,
  name: d.name,
  count: communes.filter((c) => c.department.code === d.code).length
}));

// Les données sont en « Title Case » : on repasse en casse de phrase
const sentence = (t: string) => t.charAt(0) + t.slice(1).replace(/\b(?!WC\b)\p{Lu}/gu, (c) => c.toLowerCase());
const services = servicesData.services.map((s) => ({
  title: sentence(s.title.replace(' 24/7', '')),
  description: s.description,
  features: s.features.map((f, i) => (i === 0 ? f : f.charAt(0).toLowerCase() + f.slice(1))).join(', ')
}));
const faq = faqData.faq.general;

// Premiers gestes : ce que le client peut faire avant l'arrivée du plombier
const situations = [
  {
    id: 'fuite',
    label: "Fuite d'eau",
    heading: "Fuite d'eau : les bons gestes avant notre arrivée",
    steps: [
      "Fermez le robinet d'arrêt général, en général près du compteur d'eau.",
      "Coupez le courant au tableau si l'eau approche d'une prise ou d'un appareil électrique.",
      "Épongez, placez un récipient sous la fuite et prenez des photos pour votre assurance."
    ],
    cta: 'Appeler pour une fuite'
  },
  {
    id: 'bouchon',
    label: 'WC ou évier bouché',
    heading: 'Canalisation bouchée : évitez que ça déborde',
    steps: [
      "N'actionnez plus la chasse d'eau et ne faites plus couler l'évier.",
      "Si le niveau monte, fermez le petit robinet d'arrêt situé près du WC.",
      "Évitez les déboucheurs chimiques : ils abîment les tuyaux et compliquent l'intervention."
    ],
    cta: 'Appeler pour un débouchage'
  },
  {
    id: 'eau-chaude',
    label: "Plus d'eau chaude",
    heading: "Plus d'eau chaude : deux vérifications rapides",
    steps: [
      "Regardez au tableau électrique si le disjoncteur du chauffe-eau a sauté.",
      "Vérifiez qu'il n'y a pas d'eau au pied du ballon.",
      "S'il fuit, fermez son arrivée d'eau froide et coupez son alimentation électrique."
    ],
    cta: "Appeler pour l'eau chaude"
  },
  {
    id: 'chaudiere',
    label: 'Chaudière en panne',
    heading: 'Chaudière en panne : ce qui nous aide à réparer vite',
    steps: [
      "Notez le code d'erreur affiché sur la chaudière.",
      "Relevez la pression au manomètre : elle doit se situer entre 1 et 1,5 bar à froid.",
      "Odeur de gaz ? Ouvrez les fenêtres, ne touchez à aucun interrupteur, sortez et appelez Urgence Sécurité Gaz au 0 800 47 33 33."
    ],
    cta: 'Appeler pour la chaudière'
  },
  {
    id: 'travaux',
    label: 'Travaux prévus',
    heading: 'Salle de bain, installation, mise aux normes',
    steps: [
      "Décrivez votre projet par téléphone ou avec le formulaire de devis.",
      "Nous passons voir les lieux et prendre les mesures.",
      "Vous recevez un devis gratuit et détaillé, sans engagement."
    ],
    cta: 'Appeler pour un projet'
  }
];

const etapes = [
  {
    title: 'Vous appelez',
    text: "Un plombier décroche, de jour comme de nuit. Vous décrivez ce qui se passe, il vous indique quoi faire en attendant."
  },
  {
    title: 'On vous annonce le prix',
    text: "Le devis est gratuit. Vous connaissez le coût avant que le moindre outil sorte de la caisse."
  },
  {
    title: 'On répare',
    text: "Arrivée en 30 minutes en moyenne pour une urgence. Le chantier est laissé propre."
  },
  {
    title: 'Vous payez après',
    text: "Le règlement se fait une fois l'intervention terminée : carte bancaire, chèque, virement ou espèces."
  }
];

const equipe = [
  {
    name: 'Éric',
    role: 'Artisan plombier, fondateur',
    img: '/images/team/team-1.jpg',
    text: "Du dépannage à la rénovation complète. Recherche de fuites et installation de chauffage depuis plus de 10 ans."
  },
  {
    name: 'Michel',
    role: 'Chauffage et sanitaire, certifié RGE',
    img: '/images/team/team-2.jpg',
    text: "Installation et entretien des chaudières et pompes à chaleur."
  },
  {
    name: 'Ferdinand',
    role: 'Dépannage jour et nuit',
    img: '/images/team/team-3.jpg',
    text: "Fuites, débouchages et pannes de chauffage : 12 ans d'interventions d'urgence."
  }
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Plumber',
  name: 'Eric Plomberie',
  url: Astro.site?.toString(),
  telephone: phoneIntl,
  email: contact.email,
  areaServed: { '@type': 'AdministrativeArea', name: 'Île-de-France' }
};
---

<BaseLayout title={title} description={description}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />

  <div class="home" data-phone={contact.phone} data-email={contact.email}>
    <a class="skip" href="#contenu">Aller au contenu</a>

    <header class="top">
      <a class="brand" href="/" aria-label="Eric Plomberie, accueil">
        <span class="brand__name">Eric Plomberie</span>
        <span class="brand__sub">Artisan plombier, Île-de-France</span>
      </a>
      <nav class="top__nav" aria-label="Navigation principale">
        <a href="#services">Services</a>
        <a href="#communes">Communes</a>
        <a href="#devis">Devis gratuit</a>
      </nav>
      <a class="top__tel" href={`tel:${contact.phone}`}>
        <svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2Z"/></svg>
        <span>{phoneSpaced}</span>
      </a>
    </header>

    <main id="contenu" class="page">
      <!-- Le tuyau : il court sur toute la page et se remplit au défilement -->
      <div class="pipe" aria-hidden="true"><i class="pipe__water"></i></div>

      <section class="hero">
        <div class="hero__text">
          <h1>Plombier en Île-de-France. Chez vous en 30&nbsp;minutes.</h1>
          <p class="hero__lead">
            Fuite, canalisation bouchée, plus d'eau chaude&nbsp;: Éric et son équipe se déplacent
            jour et nuit dans {totalDisplay}&nbsp;communes. Le devis est gratuit et le prix annoncé
            avant de commencer.
          </p>
          <div class="hero__actions">
            <a class="call" href={`tel:${contact.phone}`} data-main-call>
              <svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2Z"/></svg>
              <span class="call__body">
                <span class="call__num">{phoneSpaced}</span>
                <span class="call__hint">Appel direct, 24h/24 et 7j/7</span>
              </span>
            </a>
            <a class="link" href="#devis">Demander un devis gratuit</a>
          </div>
        </div>
        <figure class="hero__photo">
          <img src="/images/plumber-hero.jpg" alt="Éric, artisan plombier, en intervention sous un évier" width="1024" height="1536" fetchpriority="high" />
        </figure>
      </section>

      <section class="triage" aria-labelledby="triage-titre">
        <div class="sec-head">
          <span class="branch" aria-hidden="true"><i></i></span>
          <h2 id="triage-titre">Que se passe-t-il chez vous&nbsp;?</h2>
        </div>
        <div class="triage__box">
          <div class="triage__tabs" role="tablist" aria-label="Votre situation">
            {situations.map((s, i) => (
              <button
                type="button"
                role="tab"
                id={`tab-${s.id}`}
                aria-controls={`panel-${s.id}`}
                aria-selected={i === 0 ? 'true' : 'false'}
                tabindex={i === 0 ? 0 : -1}
              >{s.label}</button>
            ))}
          </div>
          {situations.map((s, i) => (
            <div class="triage__panel" role="tabpanel" id={`panel-${s.id}`} aria-labelledby={`tab-${s.id}`} hidden={i !== 0}>
              <h3>{s.heading}</h3>
              <ol>
                {s.steps.map((step) => <li>{step}</li>)}
              </ol>
              <a class="call call--compact" href={`tel:${contact.phone}`}>
                <svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2Z"/></svg>
                <span class="call__body">
                  <span class="call__num">{s.cta}</span>
                  <span class="call__hint">{phoneSpaced}</span>
                </span>
              </a>
            </div>
          ))}
        </div>
      </section>

      <section id="services" class="services" aria-labelledby="services-titre">
        <div class="sec-head">
          <span class="branch" aria-hidden="true"><i></i></span>
          <h2 id="services-titre">Ce que nous réparons et installons</h2>
        </div>
        <ul class="services__list">
          {services.map((s) => (
            <li>
              <h3>{s.title}</h3>
              <p class="services__desc">{s.description}.</p>
              <p class="services__feat">{s.features}.</p>
            </li>
          ))}
        </ul>
      </section>

      <section class="etapes" aria-labelledby="etapes-titre">
        <div class="sec-head">
          <span class="branch" aria-hidden="true"><i></i></span>
          <h2 id="etapes-titre">Comment se passe une intervention</h2>
        </div>
        <ol class="etapes__list">
          {etapes.map((e) => (
            <li>
              <h3>{e.title}</h3>
              <p>{e.text}</p>
            </li>
          ))}
        </ol>
      </section>

      <section class="equipe" aria-labelledby="equipe-titre">
        <div class="sec-head">
          <span class="branch" aria-hidden="true"><i></i></span>
          <h2 id="equipe-titre">Ceux qui sonnent à votre porte</h2>
        </div>
        <ul class="equipe__list">
          {equipe.map((m) => (
            <li>
              <img src={m.img} alt={`${m.name}, ${m.role.toLowerCase()}`} width="800" height="1066" loading="lazy" />
              <h3>{m.name}</h3>
              <p class="equipe__role">{m.role}</p>
              <p>{m.text}</p>
            </li>
          ))}
        </ul>
      </section>

      <section id="communes" class="communes" aria-labelledby="communes-titre">
        <div class="sec-head">
          <span class="branch" aria-hidden="true"><i></i></span>
          <h2 id="communes-titre">Nous intervenons dans votre commune</h2>
        </div>
        <div class="communes__grid">
          <div class="search">
            <label for="recherche-commune">Nom de la commune ou code postal</label>
            <div class="search__field">
              <svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5"/><path d="m16 16 4.5 4.5"/></svg>
              <input id="recherche-commune" type="search" autocomplete="off" spellcheck="false" placeholder="Versailles, 93100…" aria-describedby="recherche-etat" />
            </div>
            <p id="recherche-etat" class="search__status" role="status">
              {totalDisplay} communes desservies dans les {departements.length} départements.
            </p>
            <ul class="search__results" hidden></ul>
          </div>
          <dl class="depts">
            {departements.map((d) => (
              <div>
                <dt><span class="depts__code">{d.code}</span> {d.name}</dt>
                <dd>{d.count} communes</dd>
              </div>
            ))}
          </dl>
        </div>
        <ul class="villes">
          {featuredCommunes.map((c) => (
            <li><a href={`/communes/${c.slug}`}>{c.name}</a></li>
          ))}
        </ul>
      </section>

      <section class="faq" aria-labelledby="faq-titre">
        <div class="sec-head">
          <span class="branch" aria-hidden="true"><i></i></span>
          <h2 id="faq-titre">Les questions qu'on nous pose au téléphone</h2>
        </div>
        <div class="faq__list">
          {faq.map((q) => (
            <details>
              <summary>
                <span>{q.question}</span>
                <svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
              </summary>
              <p>{q.answer}</p>
            </details>
          ))}
        </div>
      </section>

      <section id="devis" class="devis" aria-labelledby="devis-titre">
        <div class="sec-head">
          <span class="branch" aria-hidden="true"><i></i></span>
          <h2 id="devis-titre">Demander un devis gratuit</h2>
        </div>
        <div class="devis__grid">
          <p class="devis__intro">
            Pas d'urgence&nbsp;? Décrivez votre besoin en trois lignes. Votre message part directement
            sur le téléphone d'Éric, par SMS ou par e-mail, et nous vous rappelons avec un prix.
          </p>
          <form class="form" novalidate>
            <div class="field">
              <label for="f-besoin">Votre besoin</label>
              <textarea id="f-besoin" name="besoin" rows="3" required placeholder="Robinet de cuisine qui goutte, remplacement à prévoir…"></textarea>
              <p class="field__error" id="f-besoin-err" hidden>Décrivez votre besoin en quelques mots pour que nous puissions chiffrer.</p>
            </div>
            <div class="field-row">
              <div class="field">
                <label for="f-commune">Commune</label>
                <input id="f-commune" name="commune" type="text" autocomplete="address-level2" placeholder="Montreuil…" />
              </div>
              <div class="field">
                <label for="f-nom">Votre nom</label>
                <input id="f-nom" name="nom" type="text" autocomplete="name" placeholder="Camille Durand…" />
              </div>
            </div>
            <div class="form__actions">
              <button type="submit" class="btn btn--ink" value="sms">Envoyer par SMS</button>
              <button type="submit" class="btn btn--line" value="mail">Envoyer par e-mail</button>
            </div>
          </form>
        </div>
      </section>

      <section class="final" aria-labelledby="final-titre">
        <div class="sec-head">
          <span class="branch branch--tap" aria-hidden="true"><i></i></span>
          <svg class="tap" viewBox="0 0 120 150" aria-hidden="true">
            <path class="tap__body" d="M0 34h58a26 26 0 0 1 26 26v36H62V62a6 6 0 0 0-6-6H0Z"/>
            <path class="tap__body" d="M56 96h34v10H56Z"/>
            <path class="tap__body" d="M30 34V16M14 12h32"/>
            <path class="tap__drop" d="M73 112c5 7 8 11 8 15a8 8 0 0 1-16 0c0-4 3-8 8-15Z"/>
          </svg>
          <h2 id="final-titre">L'eau n'attend pas. Nous non plus.</h2>
        </div>
        <a class="call call--xl" href={`tel:${contact.phone}`}>
          <svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2Z"/></svg>
          <span class="call__body">
            <span class="call__num">{phoneSpaced}</span>
            <span class="call__hint">Un plombier décroche, 24h/24 et 7j/7</span>
          </span>
        </a>
      </section>
    </main>

    <footer class="foot">
      <div class="foot__grid">
        <div>
          <p class="foot__name">Eric Plomberie</p>
          <p>Artisan plombier de proximité en Île-de-France.</p>
        </div>
        <div>
          <p class="foot__h">Horaires</p>
          <p>Du lundi au samedi, 7h30 à 18h<br />Urgences 24h/24 et 7j/7</p>
        </div>
        <div>
          <p class="foot__h">Contact</p>
          <p>
            <a href={`tel:${contact.phone}`}>{phoneSpaced}</a><br />
            <a href={`mailto:${contact.email}`}>{contact.email}</a>
          </p>
        </div>
      </div>
      <p class="foot__legal">
        © {new Date().getFullYear()} Eric Plomberie
        <a href="/mentions-legales">Mentions légales</a>
      </p>
    </footer>

    <div class="callbar" hidden>
      <a class="callbar__call" href={`tel:${contact.phone}`}>
        <svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2Z"/></svg>
        Appeler le {phoneSpaced}
      </a>
      <a class="callbar__devis" href="#devis">Devis</a>
    </div>
  </div>
</BaseLayout>

<style is:global>
  .home {
    /* Froid et chaud : le code couleur du robinet */
    --porcelaine: #f1f4f7;
    --email: #ffffff;
    --bleu-travail: #14245a;
    --eau-froide: #1f63d6;
    --eau-chaude: #c62d1f;
    --eau-chaude-fonce: #a52216;
    --ardoise: #46506a;
    --joint: #c9d1dc;

    --display: 'Bricolage Grotesque Variable', 'Arial Narrow', sans-serif;
    --body: 'Schibsted Grotesk Variable', system-ui, sans-serif;

    /* Géométrie du tuyau */
    --pipe-x: 14px;
    --pipe-w: 10px;
    --gut: 42px;
    --edge: 18px;
    --ease: cubic-bezier(0.16, 1, 0.3, 1);

    background: var(--porcelaine);
    color: var(--bleu-travail);
    font-family: var(--body);
    font-size: 1.0625rem;
    line-height: 1.55;
    overflow-x: clip;
    padding-bottom: 76px;
  }
  @media (min-width: 720px) {
    .home { --pipe-x: 34px; --pipe-w: 12px; --gut: 96px; --edge: 40px; padding-bottom: 0; }
  }
  @media (min-width: 1100px) {
    .home { --pipe-x: 48px; --gut: 128px; --edge: 64px; }
  }

  .home ::selection { background: var(--eau-froide); color: #fff; }
  .home :focus-visible { outline: 3px solid var(--eau-froide); outline-offset: 3px; border-radius: 2px; }
  .home input, .home textarea { caret-color: var(--eau-chaude); }
  .home a { text-underline-offset: 0.2em; text-decoration-thickness: 1.5px; }
  .home h1, .home h2, .home h3 { font-family: var(--display); text-wrap: balance; }
  .home p { text-wrap: pretty; }

  .home .ico { width: 1.25em; height: 1.25em; flex: none; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }

  .home .skip { position: absolute; left: 12px; top: -60px; z-index: 100; background: var(--bleu-travail); color: #fff; padding: 10px 14px; }
  .home .skip:focus { top: 12px; }

  /* En-tête */
  .home .top {
    max-width: 1320px; margin: 0 auto;
    display: flex; align-items: center; gap: 24px;
    padding: 14px var(--edge) 14px var(--pipe-x);
  }
  .home .brand { display: grid; text-decoration: none; margin-right: auto; }
  .home .brand__name { font-family: var(--display); font-stretch: 75%; font-weight: 800; font-size: 1.5rem; line-height: 1; letter-spacing: -0.01em; }
  .home .brand__sub { font-size: 0.8125rem; color: var(--ardoise); }
  .home .top__nav { display: none; gap: 28px; }
  .home .top__nav a { text-decoration: none; font-weight: 600; padding: 12px 0; }
  .home .top__nav a:hover { text-decoration: underline; }
  .home .top__tel { display: inline-flex; align-items: center; gap: 8px; min-height: 44px; font-weight: 700; font-variant-numeric: tabular-nums; text-decoration: none; white-space: nowrap; }
  .home .top__tel:hover { color: var(--eau-chaude); }
  @media (min-width: 860px) { .home .top__nav { display: flex; } }
  @media (max-width: 420px) { .home .brand__sub { display: none; } }

  /* Page et tuyau */
  .home .page { position: relative; max-width: 1320px; margin: 0 auto; }
  .home .page > section { margin-left: var(--gut); margin-right: var(--edge); }

  .home .pipe {
    position: absolute; z-index: 2; top: 0; height: 100%; left: var(--pipe-x); width: var(--pipe-w);
    background: var(--email); border: 2px solid var(--bleu-travail); border-top: 0; border-bottom: 0;
    overflow: hidden;
  }
  .home .pipe__water { position: absolute; inset: 0; background: var(--eau-froide); transform-origin: top; transform: scaleY(var(--level, 1)); }

  .home .sec-head { position: relative; }
  .home .branch {
    position: absolute; top: 0.62em;
    left: calc(-1 * (var(--gut) - var(--pipe-x) - var(--pipe-w)));
    width: calc(var(--gut) - var(--pipe-x) - var(--pipe-w) - 10px);
    height: var(--pipe-w);
    background: var(--email); border: 2px solid var(--bleu-travail); border-left: 0;
    border-radius: 0 3px 3px 0; overflow: hidden;
    font-size: clamp(1.9rem, 4.6vw, 3.25rem);
  }
  .home .branch i { position: absolute; inset: 0; background: var(--eau-froide); transform-origin: left; transform: scaleX(1); transition: transform 0.7s var(--ease); }
  .home.js .branch:not(.is-wet) i { transform: scaleX(0); }

  .home h2 {
    font-stretch: 75%; font-weight: 800;
    font-size: clamp(1.9rem, 4.6vw, 3.25rem); line-height: 1.04; letter-spacing: -0.005em;
    max-width: 18ch;
  }
  .home .page > section { padding-top: clamp(72px, 10vw, 136px); }
  .home .sec-head { margin-bottom: clamp(28px, 4vw, 48px); }

  /* Hero */
  .home .page > .hero { padding-top: clamp(28px, 5vw, 64px); display: grid; gap: 32px; }
